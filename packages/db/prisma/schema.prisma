/// Webhook subscription configuration (INK-157, FR-017.008).
model WebhookSubscription {
  id                     String    @id @default(uuid()) @db.Uuid
  organisationId         String    @map("organisation_id") @db.Uuid
  ownerId                String    @map("owner_id") @db.Uuid
  scope                  String    @default("organisation") @db.VarChar(20) // own | organisation
  name                   String    @db.VarChar(255)
  description            String?   @db.VarChar(500)
  targetUrl              String    @map("target_url") @db.VarChar(1024)
  httpMethod             String    @default("POST") @map("http_method") @db.VarChar(10)
  eventTypes             Json      @map("event_types") @db.JsonB // string array
  payloadVersion         String    @default("1.0") @map("payload_version") @db.VarChar(10)
  encryptedCustomHeaders String?   @map("encrypted_custom_headers") @db.Text
  filterRules            Json?     @map("filter_rules") @db.JsonB // AST filter tree
  payloadProjection      Json?     @map("payload_projection") @db.JsonB // { mode: "ALL" | "CUSTOM", includeFields: [] }
  rateLimitPerMinute     Int       @default(10) @map("rate_limit_per_minute")
  status                 String    @default("active") @db.VarChar(20) // active | disabled | suspended
  configRevision         Int       @default(1) @map("config_revision")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz()

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  owner        User                 @relation("WebhookOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  signingKeys  WebhookSigningKey[]
  deliveries   WebhookDelivery[]
  deadLetters  WebhookDeadLetter[]
  metrics      WebhookMetricBucket[]

  @@index([organisationId, status])
  @@index([ownerId])
  @@map("webhook_subscriptions")
}

