/// Transactional outbox table for immutable domain events (INK-151, INK-158).
model DomainEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  eventId        String    @unique @map("event_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(100)
  schemaVersion  String    @default("1.0") @map("schema_version") @db.VarChar(10)
  resourceType   String    @map("resource_type") @db.VarChar(50)
  resourceId     String    @map("resource_id") @db.Uuid
  sequence       Int       @default(1)
  actorKind      String    @default("user") @map("actor_kind") @db.VarChar(20) // user | service | signer | system
  actorId        String?   @map("actor_id") @db.VarChar(255)
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz()
  dataSnapshot   Json      @map("data_snapshot") @db.JsonB
  dedupeKey      String    @map("dedupe_key") @db.VarChar(255)
  dispatchState  String    @default("PENDING") @map("dispatch_state") @db.VarChar(20) // PENDING | DISPATCHED | FAILED
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@unique([organisationId, dedupeKey])
  @@index([organisationId, dispatchState])
  @@index([occurredAt])
  @@map("domain_events")
}

/// Webhook delivery record per event and subscription (INK-158).
model WebhookDelivery {
  id                String    @id @default(uuid()) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  eventId           String    @map("event_id") @db.Uuid
  subscriptionId    String    @map("subscription_id") @db.Uuid
  replayGeneration  Int       @default(1) @map("replay_generation")
  payloadBytes      String    @map("payload_bytes") @db.Text
  payloadHash       String    @map("payload_hash") @db.VarChar(128)
  configRevision    Int       @default(1) @map("config_revision")
  state             String    @default("PENDING") @db.VarChar(20) // PENDING | IN_FLIGHT | SUCCEEDED | RETRY_SCHEDULED | DEAD_LETTER | CANCELLED
  attemptCount      Int       @default(0) @map("attempt_count")
  nextAttemptAt     DateTime? @map("next_attempt_at") @db.Timestamptz()
  leaseUntil        DateTime? @map("lease_until") @db.Timestamptz()
  leaseVersion      Int       @default(1) @map("lease_version")
  lastStatusCode    Int?      @map("last_status_code")
  lastErrorCategory String?   @map("last_error_category") @db.VarChar(50)
  lastErrorMessage  String?   @map("last_error_message") @db.VarChar(1000)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        DomainEvent         @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  attempts     WebhookAttempt[]
  deadLetter   WebhookDeadLetter?

  @@unique([eventId, subscriptionId, replayGeneration])
  @@index([organisationId, state, nextAttemptAt])
  @@index([subscriptionId])
  @@map("webhook_deliveries")
}

/// Append-only HTTP delivery attempt record (INK-158, INK-161).
model WebhookAttempt {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  deliveryId      String    @map("delivery_id") @db.Uuid
